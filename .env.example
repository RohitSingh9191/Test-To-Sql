# Copy this file to .env and fill in your own values:
#     copy .env.example .env
# .env is ignored by git, so your real credentials never get committed.

# ---- LLM backend ----
# "ollama"    = local model, no API key, offline (default)
# "anthropic" = Claude (most accurate), requires ANTHROPIC_API_KEY below
T2SQL_PROVIDER=ollama

# ---- Ollama (local) ----
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# ---- Anthropic (Claude) — only used when T2SQL_PROVIDER=anthropic ----
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
T2SQL_MODEL=claude-opus-4-8

# ---- PostgreSQL (the database being queried) ----
# Host name or IP address of the PostgreSQL server
PGHOST=your-db-host
PGPORT=5432
PGDATABASE=nextgendb
# Use a read-only account if you can (see README: "Connect your database")
PGUSER=your-db-user
PGPASSWORD=your-db-password

# Only these schemas are exposed to the model / queryable.
T2SQL_SCHEMAS=pers,utility,request,training,digitalsig,public

# Safety limits
T2SQL_MAX_ROWS=500
T2SQL_STATEMENT_TIMEOUT_MS=15000
